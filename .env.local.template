# GoodQ4All Environment Variables Template
# Copy this file to .env.local and fill in your actual values
# DO NOT commit .env.local to version control!

# API Keys
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=your_voice_id_here
OPENAI_API_KEY=your_openai_api_key_here
HF_TOKEN=your_huggingface_token_here
HF_HUB_TOKEN=your_huggingface_token_here
PYANNOTE_TOKEN=your_pyannote_token_here

# Home Assistant
HA_TOKEN=your_home_assistant_jwt_token_here

# GoodQ Configuration
# Loopback is the safe default. Only set GOODQ_API_HOST=0.0.0.0 if you
# explicitly want LAN exposure on a trusted network.
GOODQ_API_HOST=127.0.0.1
GOODQ_API_PORT=30000
GOODQ_FFMPEG_EXE=
GOODQ_POPPLER_BIN=
GOODQ_STEP_TIMEOUT_MS=
GOODQ_VERBOSE=

# Notes:
# - Replace all 'your_*_here' values with actual credentials
# - Keep this file secure and never commit to git
# - Tokens can be obtained from:
#   - ElevenLabs: https://elevenlabs.io/app/settings
#   - OpenAI: https://platform.openai.com/api-keys  
#   - HuggingFace: https://huggingface.co/settings/tokens
#   - Home Assistant: Your HA instance → Profile → Long-Lived Access Tokens
