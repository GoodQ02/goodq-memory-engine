# GoodQ Environment - Model Cache Unification
# Set GOODQ_DATA_ROOT before loading this helper. Runtime authority is the
# configured GoodQ data root, not a legacy fixed-drive model cache.
GOODQ_MODEL_CACHE_ROOT=${GOODQ_DATA_ROOT}/models
HF_HOME=${GOODQ_MODEL_CACHE_ROOT}
TRANSFORMERS_CACHE=${GOODQ_MODEL_CACHE_ROOT}/transformers
HF_DATASETS_CACHE=${GOODQ_MODEL_CACHE_ROOT}/hf/datasets
TORCH_HOME=${GOODQ_MODEL_CACHE_ROOT}/torch
SENTENCE_TRANSFORMERS_HOME=${GOODQ_MODEL_CACHE_ROOT}/sentence-transformers
