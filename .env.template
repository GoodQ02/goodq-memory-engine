# GoodQ4All Environment Contract
# Version aligned with v2.4.0
# Generated via static reconciliation

# Notes
# - Leave blank to use in-code defaults unless marked otherwise.
# - Desktop strict mode usually sets GOODQ_HOST_PROFILE=GPU_ENHANCED and GOODQ_REQUIRE_WSL_AUDIO=1.
# - Laptop follower typically uses GOODQ_HOST_PROFILE=BASELINE with permissive defaults.

# Host Identity
GOODQ_HOST_PROFILE=UNSET
GOODQ_CONDA_ENV=goodq_core

# Data Root
# Optional base root override. Leave blank for bootstrap/runtime defaults, or
# set in .env.local to a machine-specific local path. Runtime data is derived
# under <GOODQ_DATA_ROOT>/GoodQ_Data.
GOODQ_DATA_ROOT=
GOODQ_MODELS_DIR=

# Conda
# Optional override; usually auto-detected
# CONDA_EXE=

# WSL
# Optional explicit distro. Leave blank to let bootstrap/verifier choose the
# first Ubuntu-like distro detected on the host.
GOODQ_WSL_DISTRO=
GOODQ_WSL_USER=
# Default when unset: /home/<GOODQ_WSL_USER>/goodq_audio
GOODQ_WSL_WORKSPACE=
GOODQ_WSL_PROJECT_ROOT=
GOODQ_WSL_VLLM_HOME=
GOODQ_WSL_MODEL_PATH=

# Strictness Flags
GOODQ_REQUIRE_GPU=0
GOODQ_REQUIRE_WSL_AUDIO=0
GOODQ_NO_AUTO_GPU=
GOODQ_WSL_AUDIO_DEVICE=
GOODQ_WSL_AUDIO_COMPUTE_TYPE=
GOODQ_WSL_AUDIO_MIXED_PRECISION=

# Model Overrides
HF_HOME=
TORCH_HOME=
TRANSFORMERS_CACHE=
HF_DATASETS_CACHE=
HF_HUB_ENABLE_HF_TRANSFER=
HF_DOWNLOAD_GATED=
TRANSFORMERS_OFFLINE=
HF_DATASETS_OFFLINE=

# Service Overrides
# Safe default: loopback only. Expose on the LAN only when explicitly intended.
GOODQ_API_HOST=127.0.0.1
GOODQ_API_PORT=30000
GOODQ_DB_PATH=
GOODQ_KG_DB_PATH=
GOODQ_PROCESSING_ROOT=
GOODQ_FAISS_DIR=
GOODQ_FAISS_AUDIO_PATH=
GOODQ_QDRANT_URL=
GOODQ_QDRANT_COLLECTION_CLIP=
GOODQ_QDRANT_COLLECTION_DINO=
GOODQ_QDRANT_COLLECTION_TEXT=
GOODQ_QDRANT_COLLECTION_AUDIO=
GOODQ_STEP_TIMEOUT_MS=
GOODQ_VERBOSE=
GOODQ_VECTOR_DEBUG=
GOODQ_RETRIEVAL_EVENTS=
GOODQ_RETRIEVAL_EVENTS_JSONL=
GOODQ_RETRIEVAL_CONTEXT=
GOODQ_COMMIT_EVENTS_JSONL=
GOODQ_SUMMARIES_PREVIEW=
GOODQ_SUMMARY_TTL_HOURS=
GOODQ_READONLY_ENVELOPE_PATH=
GOODQ_DEBUG_KEEP_TEMP=

# API Keys
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
elevenlabs_voice_id=
# Canonical Hugging Face token is HUGGINGFACE_TOKEN.
# Runtime aliasing mirrors between HUGGINGFACE_TOKEN and HF_TOKEN when one is set.
# If PYANNOTE_TOKEN is unset, it inherits canonical token; PYANNOTE_AUDIO_AUTH remains optional fallback.
HF_TOKEN=
HF_HUB_TOKEN=
HUGGINGFACE_TOKEN=
PYANNOTE_TOKEN=
PYANNOTE_AUDIO_AUTH=
HF_AUTH_TOKEN=
HA_TOKEN=

# Optional Integrations
GOODQ_HEALTH_EXPORT_URL=
GOODQ_HEALTH_SOURCE_ID=
GOODQ_VAULT_ROOT=
GOODQ_HEALTH_AUTH_HEADER=
GOODQ_HEALTH_AUTH_TOKEN=
GOODQ_CC_QUERY=
GOODQ_CC_THUMBS=
GOODQ_SMOKE_OVERRIDE_ROOT=
