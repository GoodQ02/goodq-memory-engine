# GoodQ .gitignore
# Prevents sensitive data and large files from being committed

# ===== SECRETS & CREDENTIALS =====
.env*
!.env.template
!.env.local.template
!.env.example
!.env.*.example
!.env.*.template
*.key
*.pem
secrets.yaml
*token*
*secret*

# ===== DATA & ARTIFACTS =====
# Don't commit the actual data - too large!
logs/
*/logs/
*.log
*.jsonl
data/
*.db
*.sqlite
*.sqlite3
*.faiss
*.index

# ===== MODEL CACHE =====
# Models are huge (367GB) - download separately
models/
*.pt
*.pth
*.bin
*.onnx
*.h5
*.pkl
*.pickle

# ===== PYTHON =====
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib64/
!lib/llm_client.py
!goodq4all/lib/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ===== JUPYTER =====
.ipynb_checkpoints
*.ipynb

# ===== VIRTUAL ENVIRONMENTS =====
venv/
ENV/
env/
.venv

# ===== IDE & EDITORS =====
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# ===== ZENML =====
.zenml/
zenml_store/
.zen/

# ===== TEMPORARY FILES =====
*.tmp
*.temp
*.bak
*.backup
*.backup*
~*

# ===== WINDOWS =====
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ===== VIDEO/AUDIO/IMAGE FILES =====
# Don't commit media - too large
*.mp4
*.avi
*.mov
*.mkv
*.wmv
*.flv
*.mp3
*.wav
*.flac
*.aac
*.ogg
*.m4a
*.jpg
*.jpeg
*.png
!samples/assets/*.png
*.gif
*.bmp
*.tiff
*.webp

# Exception: Keep documentation images
!docs/**/*.png
!docs/**/*.jpg
!docs/**/*.svg

# ===== WORKSPACE DIRECTORIES =====
import_inbox/
output/
exports/
run_exports/
workspace/
tmp/
temp/
snapshots/
reports/seinfeld_experiment/
configs/config.local.yaml
/config.yaml
/bootstrap_report.json
/GOODCUBE_STAGE6_WSL_PYTORCH_REPORT.md
scripts/internal/*
!scripts/internal/README.md

# ===== TESTING =====
.pytest_cache/
.pytest_tmp/
.coverage
htmlcov/
.tox/

# ===== LOCAL BOOTSTRAP/INVENTORY ARTIFACTS =====
.venv_install_audit/
temp_dir_inventory.json
temp_repo_inventory.json
/config.json

# ===== DOCUMENTATION BUILD =====
docs/_build/
site/

# ===== PACKAGE MANAGER =====
node_modules/
package-lock.json
yarn.lock

# ===== KEEP THESE =====
# Explicitly include important files
!README.md
!QUICK_REFERENCE.md
!*.bat
!envs/locks/*.txt
!docs/**/*.md
!scripts/**/*.ps1
!configs/**/*.yaml
!LICENSE
configs/config.local.yaml

# ===== ARCHIVE DIRECTORIES =====
# Archive deprecated code but not the large binary artifacts
archive/deprecated_*/
archive/**/raw/
archive/**/legacy_data/

# ===== QDRANT STORAGE =====
# Don't commit Qdrant database files - regenerate on install
vendor/qdrant/storage/
vendor/qdrant/*.log

# ===== NARRATIVE TEST ARTIFACTS =====
narrative*.txt
narrative*.err
