        ]
      },
      "side_effects": [
        "network_access"
      ],
      "risk_tier": "low",
      "idempotency": "idempotent",
      "requires_confirmation": false,
      "timeout_ms": 60000,
      "retry_policy": {
        "max_attempts": 2,
        "backoff": "fixed"
      },
      "allowed_in_modes": [
        "chat",
        "plan",
        "execute",
        "research"
      ],
      "mutability_class": "read_only"
    },
    {
      "name": "home_assistant_get_state",
