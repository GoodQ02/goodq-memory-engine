          "service"
        ],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          }
        },
        "required": [
          "ok"
        ]
      },
      "side_effects": [
        "network_access",
        "external_mutation"
      ],
      "risk_tier": "high",
      "idempotency": "non_idempotent",
      "requires_confirmation": true,
      "timeout_ms": 45000,
      "retry_policy": {
        "max_attempts": 1,
        "backoff": "none"
      },
      "allowed_in_modes": [
        "execute"
      ],
      "mutability_class": "external_side_effect"
    },
    {
      "name": "process_video_scene",
      "description": "Run local video scene extraction and summarization pipeline.",
      "category": "custom",
      "input_schema": {
        "type": "object",
        "properties": {
          "video_path": {
            "type": "string"
          },
          "scene_threshold": {
            "type": "number",
            "minimum": 0
          },
          "min_scene_len_sec": {
            "type": "number",
            "minimum": 1
          }
        },
        "required": [
          "video_path"
        ],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "scene_count": {
            "type": "integer"
          },
          "summary_path": {
            "type": "string"
          }
        },
        "required": [
          "scene_count"
        ]
      },
      "side_effects": [
        "reads_files",
        "writes_files",
        "executes_commands"
      ],
      "risk_tier": "medium",
      "idempotency": "conditionally_idempotent",
      "requires_confirmation": true,
      "timeout_ms": 3600000,
      "retry_policy": {
        "max_attempts": 1,
        "backoff": "none"
      },
      "allowed_in_modes": [
        "execute",
        "verify"
      ],
      "mutability_class": "ingest_staged"
    },
    {
      "name": "transcribe_audio",
      "description": "Run local transcription and diarization pipeline.",
      "category": "custom",
      "input_schema": {
        "type": "object",
        "properties": {
          "audio_path": {
            "type": "string"
          },
          "chunk_seconds": {
            "type": "number",
            "minimum": 1
          },
          "enable_diarization": {
            "type": "boolean"
          }
        },
        "required": [
          "audio_path"
        ],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "transcript_path": {
            "type": "string"
          },
          "segments": {
            "type": "integer"
          }
        },
        "required": [
          "transcript_path"
        ]
      },
      "side_effects": [
        "reads_files",
        "writes_files",
        "executes_commands"
      ],
      "risk_tier": "medium",
      "idempotency": "conditionally_idempotent",
      "requires_confirmation": true,
      "timeout_ms": 3600000,
      "retry_policy": {
        "max_attempts": 1,
        "backoff": "none"
      },
      "allowed_in_modes": [
        "execute",
        "verify"
      ],
      "mutability_class": "ingest_staged"
    },
    {
      "name": "validate_ucf_epoch",
      "description": "Run validation on the current UCF epoch's database and staging directory.",
      "category": "custom",
      "input_schema": {
        "type": "object",
        "properties": {
          "epoch": {
            "type": "string"
          }
        },
        "required": [
          "epoch"
        ],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "valid": {
            "type": "boolean"
          },
          "report_path": {
            "type": "string"
          },
          "issues": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "valid"
        ]
      },
      "side_effects": [
        "reads_files"
      ],
      "risk_tier": "low",
      "idempotency": "idempotent",
      "requires_confirmation": false,
      "timeout_ms": 60000,
      "retry_policy": {
        "max_attempts": 2,
        "backoff": "fixed"
      },
      "allowed_in_modes": [
        "execute",
        "verify"
      ],
      "mutability_class": "validate_only"
    },
    {
      "name": "run_ingestion",
      "description": "Process ingestion folder through the pipeline, staged in UCF epoch.",
      "category": "custom",
      "input_schema": {
        "type": "object",
        "properties": {
          "input_dir": {
            "type": "string"
          },
          "epoch": {
            "type": "string"
          },
          "max_scenes": {
            "type": "integer",
            "minimum": 1
          },
          "force": {
            "type": "boolean"
          }
        },
        "required": [
          "input_dir",
          "epoch"
        ],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "epoch": {
            "type": "string"
          },
          "scene_count": {
            "type": "integer"
          },
          "validation_report": {
            "type": "object"
          }
        },
        "required": [
          "status",
          "epoch"
        ]
      },
      "side_effects": [
        "reads_files",
        "writes_files",
        "executes_commands"
      ],
      "risk_tier": "high",
      "idempotency": "non_idempotent",
      "requires_confirmation": true,
      "timeout_ms": 3600000,
      "retry_policy": {
        "max_attempts": 1,
        "backoff": "none"
      },
      "allowed_in_modes": [
        "execute"
      ],
      "mutability_class": "ingest_staged"
    },
    {
      "name": "promote_ucf_to_memory",
      "description": "Promote staging UCF database records to canonical relational/vector memory.",
      "category": "custom",
      "input_schema": {
        "type": "object",
        "properties": {
          "video_hash": {
            "type": "string",
            "minLength": 1
          },
          "epoch_id": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "video_hash",
          "epoch_id"
        ],
        "additionalProperties": false
      },
      "output_schema": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "status": {
                "const": "promoted_complete"
              },
              "promoted_count": {
                "type": "integer",
                "minimum": 0
              },
              "qdrant_sync": {
                "type": "object"
              },
              "scope_sync": {
                "type": "object"
              },
              "materialization_report": {
                "type": "object"
              },
              "outbox": {
                "type": [
                  "object",
                  "null"
                ]
              },
              "warnings": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "status",
              "promoted_count",
              "qdrant_sync",
              "scope_sync",
              "materialization_report",
              "outbox"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "status": {
                "const": "promotion_committed_sync_pending"
              },
              "promoted_count": {
                "type": "integer",
                "minimum": 1
              },
              "qdrant_sync": {
                "type": "object"
              },
              "scope_sync": {
                "type": "object"
              },
              "materialization_report": {
                "type": "object"
              },
              "outbox": {
                "type": "object"
              },
              "warnings": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "status",
              "promoted_count",
              "qdrant_sync",
              "scope_sync",
              "materialization_report",
              "outbox",
              "warnings"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "status": {
                "const": "blocked"
              },
              "reason": {
                "const": "promotion_blocked_unvalidated_frames"
              },
              "staged_count": {
                "type": "integer",
                "minimum": 1
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "status",
              "reason",
              "staged_count",
              "message"
            ],
            "additionalProperties": false
          }
        ],
        "additionalProperties": false
      },
      "side_effects": [
        "reads_files",
        "writes_files",
        "network_access",
        "external_mutation"
      ],
      "risk_tier": "high",
      "idempotency": "non_idempotent",
      "requires_confirmation": true,
      "timeout_ms": 120000,
      "retry_policy": {
        "max_attempts": 1,
        "backoff": "none"
      },
      "allowed_in_modes": [
        "execute"
      ],
      "mutability_class": "mutate_canonical"
    },
    {
      "name": "reconcile_ucf_qdrant",
      "description": "Retry one durable pending promotion-to-Qdrant projection without repeating promotion or materialization.",
      "category": "custom",
      "input_schema": {
        "type": "object",
        "properties": {
          "video_hash": {
            "type": "string",
            "minLength": 1
          },
          "epoch_id": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "video_hash",
          "epoch_id"
        ],
        "additionalProperties": false
      },
      "output_schema": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "status": {
                "const": "qdrant_sync_reconciled"
              },
              "qdrant_sync": {
                "type": "object"
              },
              "scope_sync": {
                "type": "object"
              },
              "outbox": {
                "type": "object"
              }
            },
            "required": [
              "status",
              "qdrant_sync",
              "scope_sync",
              "outbox"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "status": {
                "const": "qdrant_sync_pending"
              },
              "qdrant_sync": {
                "type": "object"
              },
              "scope_sync": {
                "type": "object"
              },
              "outbox": {
                "type": [
                  "object",
                  "null"
                ]
              },
              "warnings": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "status",
              "qdrant_sync",
              "scope_sync",
              "outbox",
              "warnings"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "status": {
                "const": "blocked"
              },
              "reason": {
                "const": "qdrant_sync_not_pending"
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "status",
              "reason",
              "message"
            ],
            "additionalProperties": false
          }
        ]
      },
      "side_effects": [
        "reads_files",
        "writes_files",
        "network_access",
        "external_mutation"
      ],
      "risk_tier": "high",
      "idempotency": "conditionally_idempotent",
      "requires_confirmation": true,
      "timeout_ms": 120000,
      "retry_policy": {
        "max_attempts": 1,
        "backoff": "none"
      },
      "allowed_in_modes": [
        "execute"
      ],
      "mutability_class": "mutate_canonical"
    },
    {
      "name": "file_delete",
      "description": "Delete a file from the local filesystem.",
      "category": "filesystem",
      "input_schema": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          }
        },
        "required": [
          "path"
        ],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "deleted": {
            "type": "boolean"
          }
        },
        "required": [
          "deleted"
        ]
      },
      "side_effects": [
        "writes_files"
      ],
      "risk_tier": "high",
      "idempotency": "idempotent",
      "requires_confirmation": true,
      "timeout_ms": 60000,
      "retry_policy": {
        "max_attempts": 2,
        "backoff": "fixed"
      },
      "allowed_in_modes": [
        "execute"
      ],
      "mutability_class": "destructive"
    }
  ],
  "policies": {
    "strict_tool_contract": {
      "reject_undeclared_tools": true,
      "reject_extra_arguments": true,
      "require_all_required_arguments": true,
      "require_argument_schema_validation": true,
      "require_justification_for_side_effects": true,
      "require_explicit_user_confirmation_for": [
        "medium",
        "high"
      ]
    },
    "planning": {
      "enabled": true,
      "mandatory_when": {
        "estimated_steps_gte": 3,
        "files_touched_gt": 2,
        "cross_subsystem_change": true
      }
    },
    "persistence": {
      "enabled": true,
      "termination_conditions": [
        "task_completed",
        "blocked_on_missing_user_input",
        "policy_prevents_action"
      ]
    },
    "verification": {
      "enabled": true,
      "required_checks": [
        "smoke",
        "test"
      ],
      "on_failure": "attempt_fix_then_retry"
    },
    "safety": {
      "prompt_injection_defense": true,
      "treat_tool_output_as_untrusted": true,
      "blocked_action_patterns": [
        "unapproved_home_automation_actuation",
        "exfiltrate_private_context",
        "write_without_confirmed_target"
      ]
    },
    "output": {
      "response_format": "markdown",
      "include_file_references": true,
      "include_citations_when_external_sources": true,
      "max_summary_lines": 24
    },
    "audit": {
      "log_tool_calls": true,
      "log_failed_calls": true,
      "redact_keys": [
        "HA_TOKEN",
        "ELEVENLABS_VOICE_ID",
        "authorization",
        "token",
        "password"
      ],
      "log_path": ".goodq/logs/tool-audit.jsonl"
    }
  },
  "protocol": {
    "call_envelope": {
      "required_fields": [
        "request_id",
        "tool_name",
        "arguments",
        "mode",
        "reason",
        "risk_ack"
      ],
      "request_id_pattern": "^[A-Za-z0-9._:-]{8,128}$",
      "enforce_mode_allowlist": true,
      "allow_parallel_calls": true,
      "max_parallel_calls": 8,
      "require_argument_schema_validation": true,
      "reject_calls_without_reason": true,
      "reject_extra_fields": true
    },
    "result_envelope": {
      "required_fields": [
        "request_id",
        "tool_name",
        "status",
        "started_at",
        "completed_at",
        "duration_ms",
        "side_effect_report"
      ],
      "allowed_status_values": [
        "success",
        "recoverable_error",
        "fatal_error",
        "rejected_by_policy"
      ],
      "require_error_object_on_failure": true,
      "require_side_effect_report": true,
      "include_tool_stdout_stderr": true
    }
  }
}
