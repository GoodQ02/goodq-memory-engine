{
  "contract_version": "1.0.0",
  "agent": {
    "name": "GoodQ_o2 Local Multimodal Agent",
    "type": "orchestrator",
    "default_mode": "execute",
    "supported_modes": [
      "chat",
      "plan",
      "execute",
      "verify",
      "research"
    ]
  },
  "tools": [
    {
      "name": "qdrant_query",
      "description": "Query vector memory collections in local Qdrant.",
      "category": "integration",
      "input_schema": {
        "type": "object",
        "properties": {
          "collection": {
            "type": "string"
          },
          "query_vector": {
            "type": "array",
            "items": {
              "type": "number"
            }
          },
          "top_k": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "ucf_status_filter": {
            "type": "string"
          },
          "ucf_include_terminal": {
            "type": "boolean"
          },
          "payload_filter": {
            "type": "object"
          }
        },
        "required": [
          "collection",
          "query_vector"
        ],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "matches": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        },
        "required": [
          "matches"
        ]
      },
      "side_effects": [
        "network_access"
      ],
      "risk_tier": "low",
      "idempotency": "idempotent",
      "requires_confirmation": false,
      "timeout_ms": 60000,
      "retry_policy": {
        "max_attempts": 2,
        "backoff": "fixed"
      },
      "allowed_in_modes": [
        "plan",
        "execute",
        "verify",
        "research"
      ],
      "mutability_class": "read_only"
    },
    {
      "name": "qdrant_upsert",
      "description": "Write embeddings and metadata into Qdrant collections.",
      "category": "integration",
      "input_schema": {
        "type": "object",
        "properties": {
          "collection": {
            "type": "string"
          },
          "points": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        },
        "required": [
          "collection",
          "points"
        ],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "written": {
            "type": "integer"
          }
        },
        "required": [
          "written"
        ]
      },
      "side_effects": [
        "network_access",
        "external_mutation"
      ],
      "risk_tier": "high",
      "idempotency": "conditionally_idempotent",
      "requires_confirmation": true,
      "timeout_ms": 120000,
      "retry_policy": {
        "max_attempts": 1,
        "backoff": "none"
      },
      "allowed_in_modes": [
        "execute",
        "verify"
      ],
      "mutability_class": "mutate_canonical"
    },
    {
      "name": "faiss_search",
