        ],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "matches": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        },
        "required": [
          "matches"
        ]
      },
      "side_effects": [
        "reads_files"
      ],
      "risk_tier": "low",
      "idempotency": "idempotent",
      "requires_confirmation": false,
      "timeout_ms": 90000,
      "retry_policy": {
        "max_attempts": 2,
        "backoff": "fixed"
      },
      "allowed_in_modes": [
        "plan",
        "execute",
        "verify",
        "research"
      ],
      "mutability_class": "read_only"
    },
    {
      "name": "llm_chat_local",
      "description": "Call local LM Studio-compatible chat endpoint.",
      "category": "integration",
      "input_schema": {
        "type": "object",
        "properties": {
          "messages": {
            "type": "array",
