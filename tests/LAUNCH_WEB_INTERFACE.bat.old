@echo off
REM Launch GoodQ4All Web Interface
echo ================================================================================
echo   GoodQ4All Web Interface Launcher
echo ================================================================================
echo.

cd /d L:\goodq4all

echo [1/2] Activating environment...
call conda activate goodq_zenml

echo [2/2] Starting web server...
echo.
echo ================================================================================
echo   Interface will be available at: http://localhost:3000
echo   Press Ctrl+C to stop the server
echo ================================================================================
echo.

python api_server.py

pause
