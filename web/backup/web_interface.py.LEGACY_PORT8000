@app.post("/api/command")
async def execute_command(cmd: SystemCommand):
    """Execute system command"""
    try:
        command = cmd.command
        params = cmd.parameters or {}
        
        if command == "get_logs":
            log_file = Path("L:/goodq4all/logs/watchdog.log")
            if log_file.exists():
                with open(log_file, 'r', encoding='utf-8', errors='ignore') as f:
                    lines = f.readlines()
                    return {
                        "success": True,
                        "result": {"logs": lines[-params.get("lines", 100):]}
                    }
            else:
                return {
                    "success": False,
                    "error": "Log file not found"
                }
        
        elif command == "get_video_list":
            videos = []
            try:
                conn = get_db_connection(DB_PATH)
                cursor = conn.cursor()
                
                # Get unique videos by hash
                cursor.execute("""
                    SELECT DISTINCT 
                        COALESCE(video_hash, 'unknown') as hash,
                        COUNT(*) as scene_count
                    FROM scenes
                    GROUP BY video_hash
                    ORDER BY scene_count DESC
                """)
                
                for row in cursor.fetchall():
                    videos.append({
                        "hash": row[0],
                        "scenes": row[1]
                    })
                
                conn.close()
            except Exception as e:
                print(f"Error getting videos: {e}")
            
            return {
                "success": True,
                "result": {"videos": videos}
            }
        
        elif command == "get_processing_status":
            processing_path = Path("L:/goodq4all/data/processing")
            if processing_path.exists():
                items = list(processing_path.rglob("*"))
                return {
                    "success": True,
                    "result": {
                        "processing": True,
                        "item_count": len(items),
                        "items": [str(i.relative_to(processing_path)) for i in items if i.is_file()][:20]
                    }
                }
            return {
                "success": True,
                "result": {"processing": False}
            }
        
        else:
            return {
                "success": False,
                "error": f"Unknown command: {command}"
            }
    
    except Exception as e:
        return JSONResponse(
            status_code=500,
            content={
                "success": False,
                "error": str(e)
            }
        )

@app.websocket("/ws")
async def websocket_endpoint(websocket: WebSocket):
    """WebSocket endpoint for real-time updates"""
    await manager.connect(websocket)
    try:
        while True:
            data = await websocket.receive_text()
            message = json.loads(data)
            
            if message.get("type") == "query":
                result = process_natural_query(message["data"]["query"], message["data"].get("mode", "natural"))
                await manager.send_personal_message({
                    "type": "response",
                    "data": result
                }, websocket)
            
            elif message.get("type") == "ping":
                await manager.send_personal_message({
                    "type": "pong",
                    "timestamp": datetime.now().isoformat()
                }, websocket)
    
    except WebSocketDisconnect:
        manager.disconnect(websocket)

