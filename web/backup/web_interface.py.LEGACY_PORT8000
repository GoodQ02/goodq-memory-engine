                    <textarea 
                        class="input-field" 
                        id="userInput" 
                        placeholder="Ask about your memories..."
                        rows="1"
                        onkeydown="handleKeyPress(event)"
                    ></textarea>
                    <button class="send-btn" id="sendBtn" onclick="sendMessage()">
                        <span>➤</span>
                    </button>
                </div>
            </div>
        </div>
    </div>
    
    <script>
        let currentMode = 'natural';
        let isProcessing = false;
        
        // Auto-resize textarea
        const textarea = document.getElementById('userInput');
        textarea.addEventListener('input', function() {
            this.style.height = 'auto';
            this.style.height = (this.scrollHeight) + 'px';
        });
        
        // Update system stats
        async function updateStats() {
            try {
                const response = await fetch('/api/status');
                const data = await response.json();
                
                document.getElementById('sceneCount').textContent = data.database.scenes.toLocaleString();
                document.getElementById('segmentCount').textContent = data.database.segments.toLocaleString();
                document.getElementById('embeddingCount').textContent = data.database.embeddings.toLocaleString();
                document.getElementById('entityCount').textContent = data.database.entities.toLocaleString();
                
                // Update status indicator
                if (data.processing.active) {
                    document.getElementById('statusText').textContent = 'Processing...';
                    document.getElementById('statusDot').style.background = 'var(--warning)';
                } else if (data.database.scenes > 0) {
                    document.getElementById('statusText').textContent = 'System Ready';
                    document.getElementById('statusDot').style.background = 'var(--success)';
                } else {
                    document.getElementById('statusText').textContent = 'Waiting for data';
                    document.getElementById('statusDot').style.background = 'var(--primary)';
                }
            } catch (error) {
                console.error('Error fetching stats:', error);
                document.getElementById('statusText').textContent = 'Error';
                document.getElementById('statusDot').style.background = 'var(--error)';
            }
        }
        
        // Mode selection
        document.querySelectorAll('.mode-btn').forEach(btn => {
            btn.addEventListener('click', () => {
                document.querySelectorAll('.mode-btn').forEach(b => b.classList.remove('active'));
                btn.classList.add('active');
                currentMode = btn.dataset.mode;
            });
        });
        
        // Send message
        async function sendMessage() {
            const input = document.getElementById('userInput');
            const query = input.value.trim();
            
            if (!query || isProcessing) return;
            
            isProcessing = true;
            document.getElementById('sendBtn').disabled = true;
            
            // Add user message
            addMessage(query, 'user');
            input.value = '';
            input.style.height = 'auto';
            
            // Show loading
            addMessage('<div class="loading"></div>', 'assistant', true);
            
            try {
                const response = await fetch('/api/chat', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        query: query,
                        mode: currentMode
                    })
                });
                
                const data = await response.json();
                
                // Remove loading
                removeLastMessage();
                
                // Add response
                if (data.success) {
                    const answer = data.response.answer || JSON.stringify(data.response, null, 2);
                    addMessage(answer, 'assistant');
                } else {
                    addMessage(`Error: ${data.error}`, 'assistant');
                }
            } catch (error) {
                removeLastMessage();
                addMessage(`Error: ${error.message}`, 'assistant');
            }
            
            isProcessing = false;
            document.getElementById('sendBtn').disabled = false;
        }
        
        // Add message to chat
        function addMessage(content, sender, isLoading = false) {
            const chatArea = document.getElementById('chatArea');
            
            // Remove welcome
            const welcome = chatArea.querySelector('.welcome');
            if (welcome) welcome.remove();
            
            const messageDiv = document.createElement('div');
            messageDiv.className = `message ${sender}`;
            if (isLoading) messageDiv.classList.add('loading-message');
            
            const avatar = sender === 'user' ? 'U' : 'Q';
            const time = new Date().toLocaleTimeString();
            
            messageDiv.innerHTML = `
                <div class="message-avatar">${avatar}</div>
                <div class="message-content">
                    ${content}
                    <div class="message-time">${time}</div>
                </div>
            `;
            
            chatArea.appendChild(messageDiv);
            chatArea.scrollTop = chatArea.scrollHeight;
        }
        
        // Remove last message
        function removeLastMessage() {
            const chatArea = document.getElementById('chatArea');
            const loadingMsg = chatArea.querySelector('.loading-message');
            if (loadingMsg) loadingMsg.remove();
        }
        
        // Handle Enter key
        function handleKeyPress(event) {
            if (event.key === 'Enter' && !event.shiftKey) {
                event.preventDefault();
                sendMessage();
            }
        }
        
        // System commands
        async function viewLogs() {
            try {
                const response = await fetch('/api/command', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ 
                        command: 'get_logs',
                        parameters: { lines: 50 }
                    })
                });
                const data = await response.json();
                if (data.success) {
                    const logs = data.result.logs.join('').substring(0, 2000);
                    addMessage(`<pre style="max-height: 400px; overflow-y: auto; font-size: 11px; background: var(--background); padding: 12px; border-radius: 8px;">${logs}</pre>`, 'assistant');
                }
            } catch (error) {
                addMessage(`Error fetching logs: ${error.message}`, 'assistant');
            }
        }
        
        async function viewProcessing() {
            try {
                const response = await fetch('/api/command', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ command: 'get_processing_status' })
                });
                const data = await response.json();
                if (data.success) {
                    const status = data.result.processing ? 
                        `Processing active: ${data.result.item_count} files` : 
                        'No active processing';
                    addMessage(status, 'assistant');
                }
            } catch (error) {
                addMessage(`Error: ${error.message}`, 'assistant');
            }
        }
        
        async function viewVideos() {
            try {
                const response = await fetch('/api/command', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ command: 'get_video_list' })
                });
                const data = await response.json();
                if (data.success) {
                    if (data.result.videos.length > 0) {
                        const list = data.result.videos.map(v => 
                            `• ${v.path}: ${v.scenes} scenes`
                        ).join('\\n');
                        addMessage(`Processed videos:\\n${list}`, 'assistant');
                    } else {
                        addMessage('No videos processed yet. Processing in progress...', 'assistant');
                    }
                }
            } catch (error) {
                addMessage(`Error: ${error.message}`, 'assistant');
            }
        }
        
        // Initialize
        updateStats();
        setInterval(updateStats, 10000); // Update every 10 seconds
        
        // Welcome message
        setTimeout(() => {
            console.log('GoodQ4All Interface loaded successfully');
        }, 1000);
    </script>
</body>
</html>"""

