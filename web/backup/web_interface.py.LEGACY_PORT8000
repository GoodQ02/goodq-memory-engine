# Helper functions
def get_db_connection(db_path: Path):
    """Get database connection"""
    if not db_path.exists():
        raise FileNotFoundError(f"Database not found: {db_path}")
    return sqlite3.connect(str(db_path))

def get_system_stats():
    """Get current system statistics"""
    stats = {
        "scenes": 0,
        "segments": 0,
        "embeddings": 0,
        "entities": 0,
        "videos": 0
    }
    
    try:
        if DB_PATH.exists():
            conn = get_db_connection(DB_PATH)
            cursor = conn.cursor()
            
            stats["scenes"] = cursor.execute("SELECT COUNT(*) FROM scenes").fetchone()[0]
            stats["segments"] = cursor.execute("SELECT COUNT(*) FROM segments").fetchone()[0]
            stats["embeddings"] = cursor.execute("SELECT COUNT(*) FROM embeddings").fetchone()[0]
            
            conn.close()
        
        if KG_PATH.exists():
            kg_conn = get_db_connection(KG_PATH)
            kg_cursor = kg_conn.cursor()
            
            # Check if entities table exists
            table_check = kg_cursor.execute(
                "SELECT COUNT(*) FROM sqlite_master WHERE type='table' AND name='entities'"
            ).fetchone()[0]
            
            if table_check > 0:
                stats["entities"] = kg_cursor.execute("SELECT COUNT(*) FROM entities").fetchone()[0]
            
            kg_conn.close()
    
    except Exception as e:
        print(f"Error getting stats: {e}")
    
    return stats

def process_natural_query(query: str, mode: str = "natural"):
    """Process a natural language query"""
    # This is a placeholder - we'll integrate with actual analytics engine
    stats = get_system_stats()
    
    if stats["scenes"] == 0:
        return {
            "answer": "I'm currently processing your first video! Once complete, I'll be able to answer questions about your memories. Processing a large video can take some time - I'm analyzing every scene for visual content, speech, emotions, and more.",
            "status": "processing",
            "stats": stats
        }
    
    # Simple keyword-based responses for now
    query_lower = query.lower()
    
    if "how many" in query_lower or "count" in query_lower:
        return {
            "answer": f"I've analyzed {stats['scenes']} scenes across your videos, containing {stats['segments']} segments with {stats['embeddings']} embeddings. I've identified {stats['entities']} entities in the knowledge graph.",
            "stats": stats
        }
    
    if "status" in query_lower or "progress" in query_lower:
        return {
            "answer": f"System is operational. Currently have {stats['scenes']} scenes processed.",
            "stats": stats
        }
    
    return {
        "answer": f"I received your question: '{query}'. Full natural language processing will be available once the analytics engine is fully integrated. For now, I can provide system statistics and status information.",
        "query": query,
        "mode": mode,
        "stats": stats
    }

